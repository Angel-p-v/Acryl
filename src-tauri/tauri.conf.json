{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "acryl",
  "version": "0.1.0",
  "identifier": "com.angelpv.acryl",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "acryl",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/acryl.desktop"],
    "externalBin": []
  }
}
